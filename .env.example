# Required for OpenAI Realtime, Chat, and TTS
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here

# Optional model overrides
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_REALTIME_MODEL=gpt-4o-realtime-preview-2024-12-17
OPENAI_TTS_MODEL=tts-1

# Optional: rephrase engine replies via LLM (requires OpenAI key)
ENABLE_NLG_PARAPHRASE=false

# Admin protection for /dashboard, /knowledge, /gre, /training, /pilot
ADMIN_PASSWORD=

# Shared storage (Vercel Postgres) — when set, leads sync across devices
POSTGRES_URL=

# Lead retention in days (default 90)
LEAD_RETENTION_DAYS=90

# Without a valid key, the app automatically uses:
# - Local assistant (fallback conversation)
# - Browser speechSynthesis (fallback TTS)
# Voice will still work end-to-end for demo/testing.

# --- Vercel deployment ---
# 1. Push this repo to GitHub
# 2. Import in https://vercel.com/new
# 3. Add OPENAI_API_KEY under Project Settings → Environment Variables
# 4. Deploy (framework: Next.js, build: npm run build)
